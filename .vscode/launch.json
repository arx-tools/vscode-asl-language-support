{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      // the extension host loads `dist/extension.js`, so the bundle has to exist before the launch
      "preLaunchTask": "build"
    }
  ]
}
