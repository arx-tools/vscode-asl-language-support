          "match": "(?i)(\\^[a-z0-9$#&_]*)|([§£@][a-z0-9_]+)|([#$&][a-z0-9_]+)",
          "captures": {
            "1": {
              "name": "variable.other.system.asl"
            },
            "2": {
              "name": "variable.other.entity.asl"
            },
            "3": {
              "name": "variable.other.global.asl"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?i)(?<![a-z0-9_.])-?\\d+(?:\\.\\d+)?(?![a-z0-9_.])",
          "name": "constant.numeric.asl"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}]",
          "name": "punctuation.section.block.asl"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.parens.asl"
        }
      ]
    }
