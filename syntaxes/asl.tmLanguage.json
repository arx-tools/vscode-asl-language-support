{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Arx Scripting Language",
  "scopeName": "source.asl",
  "fileTypes": [
    "asl"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#events"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#labelReferences"
    },
    {
      "include": "#flow"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#flags"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.asl",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.asl",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.asl"
            }
          },
          "end": "(\")|$",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.asl"
            }
          },
          "patterns": [
            {
              "name": "variable.other.interpolated.asl",
              "match": "~[^~\\n]*~"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "variable.other.interpolated.asl",
          "match": "~[^~\\s]+~"
        }
      ]
    },
    "events": {
      "patterns": [
        {
          "name": "meta.event.disabled.asl",
          "match": "(?i)^\\s*(on)\\s+(_[a-z0-9_]+)",
          "captures": {
            "1": {
              "name": "keyword.control.event.asl"
            },
            "2": {
              "name": "entity.name.event.disabled.asl"
            }
          }
        },
        {
          "name": "meta.event.asl",
          "match": "(?i)^\\s*(on)\\s+([a-z0-9_]+)",
          "captures": {
            "1": {
              "name": "keyword.control.event.asl"
            },
            "2": {
              "name": "entity.name.event.asl"
            }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "(>>)(_?[a-z0-9_]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.label.asl"
            },
            "2": {
              "name": "entity.name.function.label.asl"
            }
          }
        }
      ]
    },
    "labelReferences": {
      "patterns": [
        {
          "match": "(?i)(?<![a-z0-9_])(goto|gosub)(?![a-z0-9_])\\s+(~[^~\\s]+~|[^\\s(){}]+)",
          "captures": {
            "1": {
              "name": "keyword.control.flow.asl"
            },
            "2": {
              "name": "entity.name.function.label.asl"
            }
          }
        }
      ]
    },
    "flow": {
      "patterns": [
        {
          "match": "(?i)(?<![a-z0-9_])(?:if|else|accept|refuse|return|random)(?![a-z0-9_])",
          "name": "keyword.control.flow.asl"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(?i)(!isgroup|(?<![a-z0-9_])(?:iselement|isin|isclass|isgroup|istype)(?![a-z0-9_])|==|!=|<=|>=|<|>)",
          "name": "keyword.operator.comparison.asl"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "match": "(?i)(?<![a-z0-9_])(?:c_?a_?m_?e_?r_?a_?t_?r_?a_?n_?s_?l_?a_?t_?e_?t_?a_?r_?g_?e_?t|d_?w_?a_?r_?f_?l_?i_?t_?t_?l_?e_?c_?r_?u_?s_?h_?e_?r_?u_?p|d_?e_?t_?a_?c_?h_?n_?p_?c_?f_?r_?o_?m_?p_?l_?a_?y_?e_?r|u_?n_?s_?e_?t_?c_?o_?n_?t_?r_?o_?l_?l_?e_?d_?z_?o_?n_?e|s_?e_?t_?p_?l_?a_?y_?e_?r_?c_?o_?l_?l_?i_?s_?i_?o_?n|a_?t_?t_?a_?c_?h_?n_?p_?c_?t_?o_?p_?l_?a_?y_?e_?r|s_?e_?t_?c_?o_?n_?t_?r_?o_?l_?l_?e_?d_?z_?o_?n_?e|s_?e_?t_?p_?l_?a_?y_?e_?r_?c_?o_?n_?t_?r_?o_?l_?s|s_?e_?t_?w_?e_?a_?p_?o_?n_?m_?a_?t_?e_?r_?i_?a_?l|s_?e_?t_?w_?o_?r_?l_?d_?c_?o_?l_?l_?i_?s_?i_?o_?n|s_?e_?t_?a_?r_?m_?o_?r_?m_?a_?t_?e_?r_?i_?a_?l|s_?e_?t_?i_?n_?t_?e_?r_?a_?c_?t_?i_?v_?i_?t_?y|a_?c_?t_?i_?v_?a_?t_?e_?p_?h_?y_?s_?i_?c_?s|c_?a_?m_?e_?r_?a_?s_?m_?o_?o_?t_?h_?i_?n_?g|i_?f_?e_?x_?i_?s_?t_?i_?n_?t_?e_?r_?n_?a_?l|i_?n_?v_?u_?l_?n_?e_?r_?a_?b_?i_?l_?i_?t_?y|p_?l_?a_?y_?e_?r_?i_?n_?t_?e_?r_?f_?a_?c_?e|p_?l_?a_?y_?e_?r_?m_?a_?n_?a_?d_?r_?a_?i_?n|p_?l_?a_?y_?e_?r_?s_?t_?a_?c_?k_?s_?i_?z_?e|s_?e_?t_?i_?n_?t_?e_?r_?n_?a_?l_?n_?a_?m_?e|s_?e_?t_?s_?t_?e_?p_?m_?a_?t_?e_?r_?i_?a_?l|s_?e_?t_?s_?t_?r_?i_?k_?e_?s_?p_?e_?e_?c_?h|s_?e_?t_?t_?r_?a_?n_?s_?p_?a_?r_?e_?n_?c_?y|t_?a_?r_?g_?e_?t_?p_?l_?a_?y_?e_?r_?p_?o_?s|c_?a_?m_?e_?r_?a_?a_?c_?t_?i_?v_?a_?t_?e|i_?n_?v_?e_?r_?t_?e_?d_?o_?b_?j_?e_?c_?t|s_?e_?t_?p_?l_?a_?y_?e_?r_?t_?w_?e_?a_?k|s_?e_?t_?s_?t_?a_?r_?e_?f_?a_?c_?t_?o_?r|c_?l_?o_?s_?e_?s_?t_?e_?a_?l_?b_?a_?g|s_?e_?t_?b_?l_?a_?c_?k_?s_?m_?i_?t_?h|s_?e_?t_?d_?e_?t_?a_?c_?h_?a_?b_?l_?e|s_?e_?t_?d_?u_?r_?a_?b_?i_?l_?i_?t_?y|s_?e_?t_?o_?b_?j_?e_?c_?t_?t_?y_?p_?e|s_?e_?t_?s_?p_?e_?a_?k_?p_?i_?t_?c_?h|c_?o_?n_?v_?e_?r_?s_?a_?t_?i_?o_?n|p_?l_?a_?y_?e_?r_?l_?o_?o_?k_?a_?t|s_?e_?t_?m_?a_?i_?n_?e_?v_?e_?n_?t|s_?e_?t_?o_?n_?e_?h_?a_?n_?d_?e_?d|s_?e_?t_?p_?o_?i_?s_?o_?n_?o_?u_?s|s_?e_?t_?r_?i_?g_?h_?t_?h_?a_?n_?d|s_?e_?t_?s_?t_?a_?c_?k_?a_?b_?l_?e|s_?e_?t_?t_?w_?o_?h_?a_?n_?d_?e_?d|s_?h_?o_?p_?c_?a_?t_?e_?g_?o_?r_?y|s_?h_?o_?p_?m_?u_?l_?t_?i_?p_?l_?y|a_?n_?c_?h_?o_?r_?b_?l_?o_?c_?k|c_?a_?m_?e_?r_?a_?f_?o_?c_?